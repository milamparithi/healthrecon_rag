# Copy to .env and adjust as needed.

# Postgres
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_VECTOR_DIMENSION=1536

# Application ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Auth / JWT
JWT_SECRET=dev-only-secret-key-please-change-in-prod-1234567890

# Openai-compatible API (required — the backend refuses to start without a key).
# Works with OpenAI or any OpenAI-compatible /v1 endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSION=1536

# RAG tuning
RAG_CHUNKING_MODE=adaptive
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=100
RAG_MAX_CHUNKS_PER_DOC=2000
RAG_TOP_K=5
RAG_MAX_HISTORY_MESSAGES=10

# Guard rails (chat safety + abuse limits)
RAG_GUARDRAILS_ENABLED=true
RAG_GUARDRAILS_MAX_INPUT_CHARS=1000
RAG_GUARDRAILS_REQUIRE_CITATION=true
RAG_GUARDRAILS_HALLUCINATION_MIN_COVERAGE=0.4
RAG_GUARDRAILS_RATE_LIMIT_REQUESTS=60
RAG_GUARDRAILS_RATE_LIMIT_WINDOW_SECONDS=60
RAG_GUARDRAILS_MAX_MESSAGES_PER_CONVERSATION=300
# Optional second-pass LLM factual-consistency judge; off by default (extra cost + latency; fail-open)
RAG_GUARDRAILS_LLM_CHECK_ENABLED=false

# Query rewriting (optional; LLM reformulates the question into a standalone search query on cache miss)
# Off by default for cost/latency; fail-open. The original message still drives the prompt/title/cache key.
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_MAX_CHARS=200
RAG_QUERY_REWRITE_SYSTEM_PROMPT=Rewrite the user's question into a single concise standalone search query that captures the exact information being asked, incorporating any context from the conversation history. Then answer with ONLY the rewritten query, no explanation.

# Semantic cache (stored in Qdrant; returns saved answers for similar questions)
# TTL is in seconds; 604800 = 7 days
RAG_CACHE_ENABLED=true
RAG_CACHE_SIMILARITY_THRESHOLD=0.92
RAG_CACHE_TTL_SECONDS=604800

# Hybrid retrieval (dense + BM25 sparse fused via RRF)
RAG_HYBRID_ENABLED=true
RAG_SEARCH_CANDIDATES=30
RAG_SEARCH_FUSION=rrf

# Optional reranker (none = fused order, lexical = in-process term overlap)
RAG_RERANK_ENABLED=false
RAG_RERANK_MODE=none

# Per-user storage quota (bytes, default 100 MB)
MAX_UPLOAD_BYTES_PER_USER=104857600

# Output evaluation & review (captures fresh chat answers; auto-flags + random sample for human review)
# EVAL_SAMPLE_RATE is the fraction of un-flagged outputs queued for review (0.0 - 1.0)
EVAL_ENABLED=true
EVAL_SAMPLE_RATE=0.1

# Langfuse Cloud observability (OpenTelemetry OTLP/HTTP -> Langfuse; off by default)
# Set LANGFUSE_ENABLED=true and add the project's public/secret keys from
# https://cloud.langfuse.com -> Project Settings -> API Keys. Events are exported
# to <host>/api/public/otel (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com,
# JP: https://jp.cloud.langfuse.com). LANGFUSE_RELEASE is the tag/version shown in the UI.
# Standalone runs (outside docker-compose) must export the same variables in the process env.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_RELEASE=
LANGFUSE_ENVIRONMENT=dev
# Fraction of chat turns traced (0.0 - 1.0); 1.0 traces everything.
LANGFUSE_SAMPLE_RATIO=1.0